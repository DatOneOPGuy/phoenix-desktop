<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for freshclam (ClamAV signature auto-updater).

  Runs Contents/Helpers/freshclam-update.sh, a wrapper that updates the
  signature DBs ONCE and exits. The ~4h cadence is owned by launchd via
  StartInterval, not by a sleep-loop in the wrapper: launchd coalesces
  intervals missed while the Mac is asleep and fires the job once on wake, so
  signatures refresh on the next wake instead of staying stale overnight (a
  self-managed sleep-loop pauses during system sleep and is never re-fired).
  Registered at runtime via SMAppService from Contents/Library/LaunchDaemons/
  in the app bundle.

  /bin/bash is explicit because the wrapper uses $RANDOM, which POSIX
  /bin/sh lacks.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.resistine.desktop.freshclam</string>

    <!-- Paths assume /Applications/Resistine.app install location -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/Resistine.app/Contents/Helpers/freshclam-update.sh</string>
    </array>

    <!-- Run once at load, then every StartInterval seconds (4h). launchd
         fires the run-once-and-exit wrapper on this cadence and coalesces
         intervals missed during system sleep into a single run on wake. No
         KeepAlive: the wrapper is meant to exit after one update, and
         relaunching it immediately would defeat the interval. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>14400</integer>

    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>

    <!-- Override hardcoded CI certs path so freshclam can verify CVD
         signatures, and point OpenSSL at the system CA bundle for TLS. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CVD_CERTS_DIR</key>
        <string>/Applications/Resistine.app/Contents/certs</string>
        <key>SSL_CERT_FILE</key>
        <string>/etc/ssl/cert.pem</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Library/Application Support/Resistine/clamav/log/freshclam-daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Resistine/clamav/log/freshclam-daemon.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
