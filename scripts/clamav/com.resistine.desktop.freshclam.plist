<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for freshclam (ClamAV signature auto-updater).

  Runs Contents/Helpers/freshclam-update.sh, a wrapper that updates the
  signature DBs on a rolling 4h + random(0-60min) cadence even while the app
  is closed. The wrapper loops forever and sleeps the jittered interval; any
  exit is unexpected, so KeepAlive relaunches it. Registered at runtime via
  SMAppService from Contents/Library/LaunchDaemons/ in the app bundle.

  /bin/bash is explicit because the wrapper uses $RANDOM, which POSIX
  /bin/sh lacks.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.resistine.desktop.freshclam</string>

    <!-- Paths assume /Applications/Resistine.app install location -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/Resistine.app/Contents/Helpers/freshclam-update.sh</string>
    </array>

    <!-- Start at boot; relaunch on any exit (infinite-loop script). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>

    <!-- Override hardcoded CI certs path so freshclam can verify CVD
         signatures, and point OpenSSL at the system CA bundle for TLS. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CVD_CERTS_DIR</key>
        <string>/Applications/Resistine.app/Contents/certs</string>
        <key>SSL_CERT_FILE</key>
        <string>/etc/ssl/cert.pem</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Library/Application Support/Resistine/clamav/log/freshclam-daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Resistine/clamav/log/freshclam-daemon.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
