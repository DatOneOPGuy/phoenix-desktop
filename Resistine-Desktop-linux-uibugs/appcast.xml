    <language>en</language>

    <!--
      To publish a new release:
      1. Update VERSION in packaging/Resistine.spec
      2. Build the DMG with ./scripts/build/build-distribution.sh
      3. Sign the DMG:  ./vpn-apple/Sparkle.framework/Resources/bin/sign_update dist/Resistine-Installer.dmg
      4. Add a new <item> with the version, signature, length, and download URL
      5. Push this file + the DMG to resistine.github.io

      IMPORTANT: sparkle:version MUST match CFBundleVersion in the app inside
      the DMG, otherwise Sparkle will re-download the same update endlessly.
    -->

    <item>
